    },
    {
      "id": "agents_meeting_room_intelligence",
      "label": "Meeting Room Intelligence System",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 7-12",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Full-stack meeting-room booking system. TypeScript monorepo (Turbo + npm workspaces): backend (Express + Apollo GraphQL + TypeORM + Socket.IO + PostgreSQL), frontend (React + Vite + Apollo Client + Tailwind). No CI, no frontend tests."
    },
    {
      "id": "agents_source_of_truth",
      "label": "Source of Truth Documents",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 14-23",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "doc/requirement.md owns requirements and business rules (FR-ids); doc/plan.md owns the phase-by-phase plan and done/open state; doc/project-state.md owns session history, decisions (§9) and traps (§8). Behaviour changes must update the matching document in the same change; content must not be restated in AGENTS.md."
    },
    {
      "id": "agents_gates",
      "label": "Required Quality Gates",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 25-36",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "npm run typecheck, npm run lint, npm run build, npm run test -w backend (safe, skips DB suites) and npm run test:db -w backend (DESTRUCTIVE) must all pass. Lint exits 0 with react-hooks/exhaustive-deps warnings; fixing them changes memo behaviour so only do so when asked. Do not add lint rules or plugins uninvited."
    },
    {
      "id": "agents_backend_layering",
      "label": "Backend Layering (Resolver → Service → Repository → Entity)",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 38-47",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Feature folders under backend/src/modules/<feature>/ are layered. A resolver must not touch a repository; a service must not import typeorm Repository directly — the repository layer exists to own SQL."
    },
    {
      "id": "agents_authorization_in_service",
      "label": "Authorization Belongs in the Service",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 48-50",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "requireAuthenticated / requireRole belong in the service, not the resolver. A service method may take an optional trailing `loaders` argument; resolvers pass ctx.loaders."
    },
    {
      "id": "agents_appcontext_loaders",
      "label": "AppContext and Per-Request DataLoaders",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 51-52",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "AppContext (backend/src/common/context.ts) carries req, res, user and the per-request DataLoaders. Loaders are per request — never module-level singletons."
    },
    {
      "id": "agents_late_repository_binding",
      "label": "Services Bind Repositories at Call Time",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 53-54",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Services construct their repositories from AppDataSource and resolve at call time, so a test can initialise that one DataSource and the whole service layer works without dependency injection plumbing."
    },
    {
      "id": "agents_serializable_transaction_protection",
      "label": "Serializable Transaction Protection for Racy Writes",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 55-56",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Writes that must not race — overlapping bookings, cancellation + waitlist conversion, maintenance windows — go through AppDataSource.transaction, sometimes SERIALIZABLE with a retry."
    },
    {
      "id": "agents_frontend_structure",
      "label": "Frontend Folder Structure and Design Tokens",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 58-61",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "src/pages per route, src/components/{layout,common,forms}, src/graphql for queries, src/realtime for the socket, src/hooks for shared hooks, src/theme for design tokens. Reuse existing components and tokens before adding new ones; theme/index.ts owns spacing, type scale and copy."
    },
    {
      "id": "agents_overlap_prevention",
      "label": "Overlap Prevention (Exclusion Constraint + Serializable Transaction)",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 64-66",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Overlap prevention is a PostgreSQL exclusion constraint plus a serializable transaction, not an application-level check alone. Never \"simplify\" it into a pre-check — the constraint is what makes concurrent requests safe."
    },
    {
      "id": "agents_cancellation_window",
      "label": "30-Minute Cancellation / Participant Window",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 67-68",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Cancellation is rejected inside 30 minutes before startTime; participant add/remove has the same window. Test fixtures must not use startOfNextHour() for these because it can land inside the window."
    },
    {
      "id": "agents_waitlist_validity",
      "label": "Waitlist Entry Validity Rule",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 69-70",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A waitlist entry is only valid when the window is genuinely unavailable (an overlapping confirmed booking exists) and not blocked by maintenance."
    },
    {
      "id": "agents_maintenance_create_refusal",
      "label": "MaintenanceService.create Overlap Refusal",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 71-72",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "MaintenanceService.create refuses a window that overlaps a confirmed booking, so any test needing both to exist must insert the booking through a fixture instead of the service."
    },
    {
      "id": "agents_uniqueness_by_name",
      "label": "Room and Equipment Uniqueness by Name",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 73-73",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Room uniqueness is by name; EquipmentService.create refuses a duplicate name."
    },
    {
      "id": "agents_recurrence_id",
      "label": "recurrenceId Series Grouping",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 74-74",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "recurrenceId groups occurrences; an occurrence can be cancelled without cancelling the series."
    },
    {
      "id": "agents_test_colocation",
      "label": "Test Suite Colocation Convention",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 78-78",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Suites live beside the code they test: backend/src/modules/<feature>/<feature>-service.test.ts."
    },
    {
      "id": "agents_destructive_db_tests",
      "label": "Destructive DB Test Suites (RUN_DB_TESTS=1)",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 79-84",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "DB suites truncate every table between tests and only run behind RUN_DB_TESTS=1 (npm run test:db -w backend). Never run them against a database you have not been asked to touch; the test DataSource prints the target database name on start. After a run the database is left empty on purpose, so npm run seed -w backend restores demo data; the seed is a no-op while rows exist, so truncate first if a run crashed before teardown."
    },
    {
      "id": "agents_test_fixtures",
      "label": "describeDb Test Fixture Layer",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 85-86",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Use describeDb from backend/src/test/test-utils.ts and the fixture helpers next to it. Do not invent a second fixture layer."
    },
    {
      "id": "agents_migrations_glob_trap",
      "label": "Test DataSource Clears Migrations Glob",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 87-89",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The test DataSource clears TypeORM's migrations glob on purpose: TypeORM require()s migration files during initialize() and cannot load .ts under Vitest. Do not \"fix\" this by making the app migrations .js."
    },
    {
      "id": "agents_apollo_skip_refetch_trap",
      "label": "Apollo skip Does Not Survive refetch()",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 93-93",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Apollo's skip does not survive refetch(); a validity guard has to live in the refetch handler."
    },
    {
      "id": "agents_unplugin_swc_decorators",
      "label": "unplugin-swc Needed for Decorator Metadata",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 94-95",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "esbuild does not emit decorator metadata, so Vitest needs unplugin-swc (backend/vitest.config.ts). Removing it breaks every entity."
    },
    {
      "id": "agents_booking_recurrenceid_typing",
      "label": "Booking.recurrenceId Typed as string",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 96-96",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Booking.recurrenceId is typed string, not string | null, although the column is nullable — a deliberate mismatch consumers must not \"fix\" by widening blindly."
    },
    {
      "id": "agents_graphql_nullable_arg_trap",
      "label": "GraphQL nullable Arg Arrives as Explicit null",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 97-98",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A GraphQL arg declared nullable: true arrives as explicit null; a `= {}` default parameter does not cover it."
    },
    {
      "id": "agents_socket_bind_order",
      "label": "socket.ts Handler Bind-Order Trap",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 99-99",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "socket.ts handlers bind to the socket that exists at bind time. Connect first, then subscribe."
    },
    {
      "id": "agents_manual_commit_workflow",
      "label": "Manual Commit by the User",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 103-104",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The user commits manually. Do not run git commit, git add -A, or push unless asked in that same request."
    },
    {
      "id": "agents_minimal_change_workflow",
      "label": "No Uninvited Dependencies and Minimal Scope",
      "file_type": "rationale",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 105-111",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Do not add a dependency, service, config knob or phase without being asked; if a fix seems to need one, say so and let the user decide. Do not create documentation files unless asked. Keep changes in the layer that owns the behaviour and avoid opportunistic refactors, renames and cleanup in unrelated files. Temporary verification scripts belong outside the repo (e.g. /tmp) and nothing test-harness related gets committed unless asked."
    },
    {
      "id": "agents_graphify_workflow",
      "label": "graphify Knowledge-Graph Workflow",
      "file_type": "concept",
      "source_file": "/Users/deepanshusingh/Desktop/PracticeFolder/Book-MeetingRoom/AGENTS.md",
      "source_location": "lines 113-124",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The project keeps a knowledge graph at graphify-out/. For codebase questions run `graphify query \"<question>\"` first when graphify-out/graph.json exists, `graphify path \"<A>\" \"<B>\"` for relationships and `graphify explain \"<concept>\"` for focused concepts, returning a scoped subgraph smaller than GRAPH_REPORT.md. Dirty graphify-out files are expected and are not a reason to skip. Use graphify-out/wiki/index.md for broad navigation; read GRAPH_REPORT.md only for broad architecture review. After modifying code run `graphify update .` (AST-only, no API cost)."
    }
  ],
